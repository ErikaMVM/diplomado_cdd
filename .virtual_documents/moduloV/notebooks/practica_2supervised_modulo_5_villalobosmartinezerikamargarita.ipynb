








## Generales
import pandas as pd
import numpy as np

## Exploración de datos
from skimpy import skim
import data_profiling
from data_profiling import ProfileReport

## sckit-learn
from sklearn.preprocessing import StandardScaler, MinMaxScaler, RobustScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.linear_model import LinearRegression, Ridge, Lasso
from sklearn.model_selection import RandomizedSearchCV
from sklearn.metrics import mean_absolute_error, mean_absolute_percentage_error

## Gráficos
import matplotlib.pyplot as plt





df_tpay = pd.read_csv('../data/practica_2/train_PAY_AMT1.csv', sep='|')


df_tpay.head()





df_vpay = pd.read_csv('../data/practica_2/val_PAY_AMT1.csv', sep='|')


df_vpay.head()


%%time
skim(df_vpay)





profile = ProfileReport(df_tpay.sample(frac=0.25).drop(columns=["ACCOUNT_ID"]), title="Profiling Report", plot={"wordcloud": {"enable": False}})


%%time
profile








var_id = ["ACCOUNT_ID"] # 1 variables


var_cat = ["SEX", "MARRIAGE", "EDUCATION"] # 3 variables


var_target = ["PAY_AMT1"] # 1 variable


var_num = list(set(df_tpay.columns) - set(var_id) - set(var_cat) - set(var_target)) # n varaibles





def limpiar_variables(df: pd.DataFrame) -> pd.DataFrame:
    """
    Aplica transformaciones a las variables MARRIAGE y EDUCATION:
    - Une MARRIAGE=3 (otros) con MARRIAGE=0 (nulo) → todos quedan como 0
    - Une EDUCATION=0 (nulo), 5 y 6 (desconocido) con EDUCATION=4 (otros) → todos quedan como 4
    """

    # MARRIAGE: unir 3 con 0
    df['MARRIAGE'] = df['MARRIAGE'].replace({3: 0})

    # EDUCATION: unir 5 y 6 con 4
    df['EDUCATION'] = df['EDUCATION'].replace({5: 4, 6: 4, 0: 4})

    return df





df_tpay = limpiar_variables(df_tpay)


df_tpay["MARRIAGE"].unique()


df_tpay["EDUCATION"].unique()





df_vpay = limpiar_variables(df_vpay)


df_vpay["MARRIAGE"].unique()


df_vpay["EDUCATION"].unique()





X_train = df_tpay.drop(columns=var_id + var_target)


y_train = df_tpay[var_target]


preprocessor = ColumnTransformer(
    transformers=[
        ("num", StandardScaler(), var_num),  # placeholder, se ajustará en el search
        ("cat", OneHotEncoder(handle_unknown="ignore"), var_cat)
    ],
    remainder="drop"
)


pipe = Pipeline(steps=[
    ("preprocessor", preprocessor),
    ("regressor", LinearRegression())
])








param_distributions = [
    {
        "preprocessor__num": [StandardScaler(), MinMaxScaler(), RobustScaler(), "passthrough"],
        "regressor": [LinearRegression()]
    },
    {
        "preprocessor__num": [StandardScaler(), MinMaxScaler(), RobustScaler(), "passthrough"],
        "regressor": [Ridge()],
        "regressor__alpha": [0.1, 1.0, 10.0, 100.0]
    },
    {
        "preprocessor__num": [StandardScaler(), MinMaxScaler(), RobustScaler(), "passthrough"],
        "regressor": [Lasso()],
        "regressor__alpha": [0.001, 0.01, 0.1, 1.0]
    }
]


random_search = RandomizedSearchCV(
    pipe,
    param_distributions=param_distributions,
    n_iter=10,  # número de combinaciones aleatorias a probar
    cv=4,
    scoring="neg_mean_absolute_error",
    n_jobs=-1,
    verbose=1,
    random_state=42
)





%%time
random_search.fit(X_train, y_train)


best_pipeline = random_search.best_estimator_
print("Mejores parámetros:", random_search.best_params_)


# Predicciones en entrenamiento
y_train_pred = best_pipeline.predict(X_train)


# MAE
mae = mean_absolute_error(y_train, y_train_pred)
# MAPE
mape = mean_absolute_percentage_error(y_train, y_train_pred)


print(f"MAE (train): {mae:.4f}")
print(f"MAPE (train): {mape:.4f}")





X_valid = df_vpay.drop(columns=var_id)


y_pred = best_pipeline.predict(X_valid)


df_result = pd.DataFrame({
    "ACCOUNT_ID": df_vpay["ACCOUNT_ID"],
    "y_hat": y_pred
})


df_result.to_csv("../data/practica_2/predicciones_PAY_AMT1.csv", index=False)








