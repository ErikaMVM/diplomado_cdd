def prediccion(model, df_valid, var_num, var_cat, id_col="ACCOUNT_ID"):
    # Inputs
    X_inputs = [df_valid[var_num]] + [df_valid[col] for col in var_cat]

    # Predicción
    y_pred = model.predict(X_inputs)

    # Outputs
    df_result = pd.DataFrame({
        id_col: df_valid[id_col].values,
        "y_hat": y_pred.flatten()  # asegurar vector plano
    })

    return df_result





