def eda(df, drop_cols=None, frac=0.25, title="Profiling Report"):
    if drop_cols is not None:
        df = df.drop(columns=drop_cols)

    profile = ProfileReport(
        df.sample(frac=frac),
        title=title,
        plot={"wordcloud": {"enable": False}}
    )
    return profile





