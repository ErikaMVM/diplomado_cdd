def preprocesamiento(var_num, var_cat):
    return ColumnTransformer([
        ("num", StandardScaler(), var_num), # Escaalado de valores numéricas
        ("cat", "passthrough", var_cat) # Conservación para embeddings
    ], remainder="drop") # Se descartan variables que no son numéricas ni categóricas


data_processed = preprocesamiento(var_num, var_cat)


def prep_apply(data_processed, df_train, df_valid, var_target):
    X_train = data_processed.fit_transform(df_train)
    y_train = df_train[var_target]
    X_valid = data_processed.transform(df_valid)
    return X_train, y_train, X_valid





X_train_r, y_train_r, X_valid_r = prep_apply(data_processed, df_tpay, df_vpay, var_target_r)





X_train_c, y_train_c, X_valid_c = prep_apply(data_processed, df_t, df_v, var_target_c)








def make_autoencoder(X_train, encoding_dim=16, batch_size=64, epochs=50):
    input_dim = X_train.shape[-1]
    inp = Input(shape=(input_dim,))
    encoded = Dense(encoding_dim, activation="relu")(inp)
    decoded = Dense(input_dim, activation="linear")(encoded)
    autoencoder = Model(inp, decoded)
    encoder = Model(inp, encoded)
    autoencoder.compile(optimizer="adam", loss="mse")
    autoencoder.fit(X_train, X_train, epochs=epochs, batch_size=256, 
                    validation_split=0.2, verbose=0)
    return encoder





