def modelado_reg(df_train, var_num, var_cat):
    input_num = Input(shape=(len(var_num),), name="Numéricas")
    inputs_cat, embeddings = [], []
    for col in var_cat:
        n_cat = int(df_train[col].max()) + 1
        emb_dim = int(n_cat**0.5)
        
        inp = Input(shape=(1,), name=f"{col}_Input")
        emb = Embedding(input_dim=n_cat, output_dim=emb_dim)(inp)
        emb = Flatten()(emb)
        
        inputs_cat.append(inp)
        embeddings.append(emb)

    concat = Concatenate()([input_num] + embeddings)
    
    x = Dense(64, activation="relu")(concat)
    output = Dense(1, activation="linear")(x)
    model = Model(inputs=[input_num] + inputs_cat, outputs=output)
    model.compile(optimizer="adam", loss="mse", metrics=["mae"])

    return model


model_r = modelado_reg(df_tpay, var_num, var_cat)





def modelado_clas(df_train, var_num, var_cat):
    input_num = Input(shape=(len(var_num),), name="Numericas")
    inputs_cat, embeddings = [], []
    for col in var_cat:
        n_cat = int(df_train[col].max()) + 1
        emb_dim = int(n_cat**0.5)
        inp = Input(shape=(1,), name=f"{col}_Input")
        emb = Embedding(input_dim=n_cat, output_dim=emb_dim)(inp)
        emb = Flatten()(emb)
        inputs_cat.append(inp)
        embeddings.append(emb)

    concat = Concatenate()([input_num] + embeddings)

    x = Dense(64, activation="relu")(concat)
    x = Dense(32, activation="relu")(x)
    output = Dense(1, activation="sigmoid")(x)
    model = Model(inputs=[input_num] + inputs_cat, outputs=output)
    model.compile(optimizer="adam", loss="binary_crossentropy", metrics=["accuracy"])

    return model


model_c = modelado_clas(df_t, var_num, var_cat)








def entrenamiento(model, df_train, y_train, var_num, var_cat,
                    epochs=30, batch_size=256, validation_split=0.2, verbose=0):

    X_inputs = [df_train[var_num]] + [df_train[col] for col in var_cat]

    history = model.fit(
        X_inputs,
        y_train,
        epochs=epochs,
        batch_size=batch_size,
        validation_split=validation_split,
        verbose=verbose
    )
    return history





# Crear el modelo de regresión con embeddings
model_r = modelado_reg(df_tpay, var_num, var_cat)


# Entrenar el modelo
history_r = entrenamiento(
    model_r,
    df_tpay,
    y_train_r,
    var_num=var_num,
    var_cat=var_cat,
    epochs=50,
    batch_size=128
)


