def limpiar_variables(df: pd.DataFrame) -> pd.DataFrame:
    """
    - MARRIAGE=3 (otros), MARRIAGE=0 (nulo) → todos quedan como 0
    - EDUCATION=0 (nulo), 5 y 6 (desconocido), EDUCATION=4 (otros) → todos quedan como 4
    """

    # MARRIAGE: unir 3 con 0
    df['MARRIAGE'] = df['MARRIAGE'].replace({3: 0})

    # EDUCATION: unir 5 y 6 con 4
    df['EDUCATION'] = df['EDUCATION'].replace({5: 4, 6: 4, 0: 4})

    return df





