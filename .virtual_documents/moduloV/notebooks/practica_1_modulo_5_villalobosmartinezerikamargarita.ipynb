df_port = pd.read_json("../data/practica_1/portfolio.json", 
                       lines=True,   # clave: formato NDJSON
                       encoding="utf-8")


df_port.head()





df_prof = pd.read_json("../data/practica_1/profile.json", 
                       lines=True,   # clave: formato NDJSON
                       encoding="utf-8")


df_prof.head()





df_tran = pd.read_json("../data/practica_1/transcript.json", 
                       lines=True,   # clave: formato NDJSON
                       encoding="utf-8")


df_tran.head()








%%time
skim(df_port)


# Convertir listas en columnas binarias
df_channels = df_port['channels'].explode()        # "desarma" las listas
df_channels = pd.get_dummies(df_channels)          # crea columnas binarias
df_channels = df_channels.groupby(level=0).max()   # reconstruye filas originales


# Unir al DataFrame original
df_port = pd.concat([df_port.drop(columns=['channels']), df_channels], axis=1)


df_port.head()


df_port.isnull().sum()





%%time
skim(df_prof)


df_prof["became_member_on"] = pd.to_datetime(df_prof["became_member_on"], format="%Y%m%d")


df_prof.head()





%%time
skim(df_tran)


df_tran['value'].apply(lambda x: list(x.keys())).value_counts()


def extract_fields(x):
    if not isinstance(x, dict):
        return pd.Series([None, None, None])
    return pd.Series([
        x.get('offer id') or x.get('offer_id'),  # coalesce entre offer id y offer_id
        x.get('amount'),
        x.get('reward')
    ])


%%time
df_tran[['offer_id', 'amount', 'reward']] = df_tran['value'].apply(extract_fields)


# Se elimina columna original 'value'
df_tran = df_tran.drop(columns=['value'])


df_tran.head()


%%time
skim(df_tran)


df_tran = df_tran.drop('reward', axis=1)





# Unión transacciones con perfiles
df_tran_prof = df_tran.merge(df_prof, left_on='person', right_on='id', how='left')


df_tran_prof.head()


# Unión con portafolio de ofertas
df_final = df_tran_prof.merge(df_port, left_on='offer_id', right_on='id', how='left', suffixes=('_prof', '_port'))


df_final.head()


# Limpieza de columnas duplicadas de 'id'
df_final = df_final.drop(columns=['id_prof', 'id_port'], errors='ignore')


df_final.head()


df_final.shape





%%time
skim(df_final)


profile = ProfileReport(df_final.sample(frac=0.25).drop(columns=["person", "offer_id"]), title="Profiling Report", plot={"wordcloud": {"enable": False}})


%%time
profile





# amount
df_final['amount_missing'] = df_final['amount'].isna().astype(int)
df_final['amount'] = df_final['amount'].fillna(df_final['amount'].median())


# income
df_final['income'] = df_final['income'].fillna(df_final['income'].median())


# reward, difficulty, duration
for col in ['reward', 'difficulty', 'duration']:
    df_final[f'{col}_missing'] = df_final[col].isna().astype(int)
    df_final[col] = df_final[col].fillna(df_final[col].median())


# canales (bool)
for col in ['email', 'mobile', 'social', 'web']:
    df_final[col] = df_final[col].fillna(0).astype(int)


# gender: imputar con moda
mode_gender = df_final['gender'].mode()[0]
df_final['gender'] = df_final['gender'].fillna(mode_gender)


# offer_type: crear categoría 'missing'
df_final['offer_type'] = df_final['offer_type'].fillna('missing')


df_final.head()


skim(df_final)





var_num = ["time", "amount", "age", "income", "reward", "difficulty", "duration"] # 7 varaibles


var_id = ["person", "offer_id"] # 2 variables


var_cat = ["gender", "offer_type", "event"] # 3 variables


var_date = ["became_member_on"] # 1 variable


var_bool = list(set(df_final.columns) - set(var_num)- set(var_id) - set(var_cat) - set(var_date)) # 8 variables


#Usamos robust-scaling
robustscaler = RobustScaler()
robustscaler.fit(df_final[var_num])


%%time
df_scaled = pd.DataFrame(robustscaler.transform(df_final[var_num]), columns = df_final[var_num].columns, index = df_final[var_num].index)


df_scaled





df_final["gender"].unique()


df_final["offer_type"].unique()


df_final["event"].unique()


# gender: LabelEncoder
le_gender = LabelEncoder()
df_final["gender_encode"] = le_gender.fit_transform(df_final["gender"])


# offer_type: LabelEncoder
le_offer_type = LabelEncoder()
df_final["offer_type_encode"] = le_offer_type.fit_transform(df_final["offer_type"])


# event: LabelEncoder
le_event = LabelEncoder()
df_final["event_encode"] = le_event.fit_transform(df_final["event"])


#Eliminamos las variables ya codificadas
df_final = df_final.drop(["gender", "offer_type", "event"], axis = 1)


df_final


df_input = pd.concat([
    df_scaled,                                            # numéricas escaladas
    df_final[var_bool],                                   # booleanas
    df_final[var_id],                                     # IDs
    df_final[var_date],                                   # fecha
    df_final[["gender_encode", "offer_type_encode", "event_encode"]]      # categóricas codificadas
], axis=1)


df_input


df_data = df_input.drop(columns=["person", "offer_id", "became_member_on"], axis=1)


df_data








%matplotlib inline


# Reducción con PCA a N componentes
pca_model = PCA(n_components=18, random_state=42)
embedding_pca = pca_model.fit_transform(df_data)


# Función para graficar el codo
def codo(X, min_compo, max_compo):
    model = KMeans(random_state=42)
    visualizer = KElbowVisualizer(model, k=(min_compo, max_compo))
    visualizer.fit(X)
    return visualizer.show()


# Ejecución del codo sobre PCA
codo(embedding_pca, 2, 18)





%%time
# Diccionario para guardar resultados
results = []

# --- KMeans ---
kmeans = KMeans(n_clusters=6, random_state=42, n_init=10)
labels_kmeans = kmeans.fit_predict(embedding_pca)

# Crear una muestra para métricas
X_sample, labels_sample = resample(
    embedding_pca, labels_kmeans,
    n_samples=5000, random_state=42
)

# Calcular métricas sobre la muestra
results.append({
    "method": "KMeans",
    "Silhouette": silhouette_score(X_sample, labels_sample),
    "Davies-Bouldin": davies_bouldin_score(X_sample, labels_sample),
    "Calinski-Harabasz": calinski_harabasz_score(X_sample, labels_sample)
})


results_df = pd.DataFrame(results)
print(results_df)


%%time
results = []

# --- GMM ---
gmm = GaussianMixture(n_components=6, random_state=42)
labels_gmm = gmm.fit_predict(embedding_pca)

# Crear muestra para métricas
X_sample, labels_sample = resample(
    embedding_pca, labels_gmm,
    n_samples=5000, random_state=42
)

# Calcular métricas sobre la muestra
results.append({
    "method": "GMM",
    "Silhouette": silhouette_score(X_sample, labels_sample),
    "Davies-Bouldin": davies_bouldin_score(X_sample, labels_sample),
    "Calinski-Harabasz": calinski_harabasz_score(X_sample, labels_sample)
})


results_df = pd.DataFrame(results)
print(results_df)





%%time
for k in range(2, 11):
    km = KMeans(n_clusters=k, random_state=200, n_init=10)
    labels = km.fit_predict(embedding_pca)

    # Crear muestra para métricas
    X_sample, labels_sample = resample(
        embedding_pca, labels,
        n_samples=5000, random_state=42
    )

    # Visualización de silueta
    visualizer = SilhouetteVisualizer(km, colors='yellowbrick')
    visualizer.fit(X_sample, labels_sample)
    print(f"N Clusters : {k}")
    print(f"Score Silueta : {round(silhouette_score(X_sample, labels_sample), 2)}")
    visualizer.show()





# Reducción de dimensiones a 3 componentes con PCA
pca_vis3d = PCA(n_components=3, random_state=42)
embedding_3d = pca_vis3d.fit_transform(df_data)


# KMeans con 6 clusters (según tu codo)
KM_6 = KMeans(n_clusters=6, n_init=100, init='k-means++', random_state=42).fit(embedding_3d)
labels = KM_6.labels_


# Crear DataFrame con etiquetas
datos_vis = pd.DataFrame({
    "comp1": embedding_3d[:,0],
    "comp2": embedding_3d[:,1],
    "comp3": embedding_3d[:,2],
    "cluster": labels
})


%%time
fig = px.scatter_3d(
    datos_vis, x="comp1", y="comp2", z="comp3",
    color=datos_vis["cluster"].astype(str),
    labels={"comp1": "Componente 1", "comp2": "Componente 2", "comp3": "Componente 3"},
    title="Clusters con PCA (3 componentes) + KMeans (6 clusters)"
)

fig.update_traces(
    marker=dict(size=6, line=dict(width=0, color="Black")),
    selector=dict(mode="markers")
)

fig.update_layout(
    width=900,
    height=700
)

fig.show()



