# Función para graficar el codo
def codo(X, min_compo, max_compo):
    model = KMeans(random_state=42)
    visualizer = KElbowVisualizer(model, k=(min_compo, max_compo))
    visualizer.fit(X)
    return visualizer.show()

# Ejecución del codo
codo(embedding_cluster, 2, 20)








