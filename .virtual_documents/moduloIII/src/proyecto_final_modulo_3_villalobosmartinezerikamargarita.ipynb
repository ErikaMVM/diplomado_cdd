def outliers_iforest(df, contamination=0.04, random_state=1989):
    model = IForest(contamination=contamination, random_state=random_state)
    model.fit(df.values)
    preds = model.predict(df.values)
    return df[preds == 1]  # 1 = inliers, -1 = outliers


