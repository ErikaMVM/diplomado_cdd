def plot_bayesridge_imputation(df_original, df_imputed, column, bins=30):
    """
    Compara la distribución original vs. imputada para una variable específica
    después de imputación multivariada con BayesianRidge.
    """
    original = df_original[column].dropna()
    imputada = df_imputed[column]

    plt.figure(figsize=(6, 4))
    sns.kdeplot(original, label="Original (sin nulos)", fill=True, color="purple", alpha=0.4)
    sns.kdeplot(imputada, label="Imputada (BayesianRidge)", fill=True, color="orange", alpha=0.6)
    plt.title(f'Distribución de "{column}" antes y después de imputación')
    plt.xlabel(column)
    plt.ylabel("Densidad")
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()


df_imp, reporte = impute_bayesridge(df, var_num)

for col in var_num:
    plot_bayesridge_imputation(df, df_imp, col)


