def is_zero_df(df):
    # Establecemos el resumen de ceros por columna
    zero_summary = (
        (df == 0).sum()
        .reset_index()
        .rename(columns={"index": "columna", 0: "n_zeros"})
    )

    # Totales y proporciones
    zero_summary["total"] = len(df)
    zero_summary["prop_zeros"] = zero_summary["n_zeros"] / zero_summary["total"]
    zero_summary["per_zeros"] = zero_summary["prop_zeros"].map(lambda x: f"{x:.2%}")
    zero_summary["prop_original"] = 1 - zero_summary["prop_zeros"]
    zero_summary["per_original"] = zero_summary["prop_original"].map(lambda x: f"{x:.2%}")

    # Filtramos solo columnas con al menos 1 cero
    zero_summary = zero_summary[zero_summary["n_zeros"] > 0].reset_index(drop=True)

    # Agregamos fila resumen global
    total_zeros = (df == 0).sum().sum()
    total_elements = df.size
    prop_zeros_global = total_zeros / total_elements
    prop_original_global = 1 - prop_zeros_global

    resumen = pd.DataFrame({
        "columna": ["TOTAL"],
        "n_zeros": [total_zeros],
        "total": [total_elements],
        "prop_zeros": [prop_zeros_global],
        "per_zeros": [f"{prop_zeros_global:.2%}"],
        "prop_original": [prop_original_global],
        "per_original": [f"{prop_original_global:.2%}"]
    })

    # Creamos la tabla final
    zero_summary = pd.concat([zero_summary, resumen], ignore_index=True)

    return zero_summary


is_zero_df(df)


#Definimos un objeto para graficar
class analyze:
    # Inicializamos la clase
    def __init__(self, df, num_vars):
        self.df = df
        self.num_vars = num_vars

    #Método para graficar variables numéricas
    def plot_num(self):
        for var in self.num_vars:
            fig = make_subplots(rows=1, cols=2, subplot_titles=(f"{var} - Boxplot", f"{var} - Histograma"))

            # Boxplot
            fig.add_trace(
                go.Box(y=self.df[var], name="Boxplot", marker_color="#0DC3DB"),
                row=1, col=1
            )

            # Histograma
            fig.add_trace(
                go.Histogram(x=self.df[var], name="Histograma",
                             marker_color="#0DC3DB", nbinsx=50,
                             histnorm='probability density'),
                row=1, col=2
            )

            fig.update_layout(title_text=f"Variable: {var}", height=400, width=800)
            fig.show()

    #Método para graficar la matriz de correlación de numéricas
    def corr_matrix(self):
        corr_matrix = self.df[self.num_vars].corr()

        #print(corr_matrix)

        fig = go.Figure(data=go.Heatmap(
            z=corr_matrix.values,
            x=corr_matrix.columns,
            y=corr_matrix.columns,
            colorscale='Viridis',
            text=corr_matrix.round(2).values,
            texttemplate="%{text}"
        ))

        fig.update_layout(
            title='Matriz de Correlación',
            width=800,
            height=600
        )
        fig.show()


