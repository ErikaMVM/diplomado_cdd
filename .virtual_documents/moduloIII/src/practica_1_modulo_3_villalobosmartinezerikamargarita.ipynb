def evaluate_imputation(df_original, df_imputed, vars_num=None):
    resultados = []

    # KS test en variables numéricas
    if vars_num:
        for col in vars_num:
            orig = df_original[col].dropna()
            imp = df_imputed[col]
            stat, pval = ks_2samp(orig, imp)
            resultados.append({
                "Variable": col,
                "Tipo": "Numérica",
                "Prueba": "KS test",
                "Estadístico": stat,
                "p-value": pval
            })

    return pd.DataFrame(resultados)


def impute_bayesridge(df_missing, vars_num, random_state=1989, max_iter=100, min_value=None):
    df_copy = df_missing.copy()

    # IterativeImputer trabaja sobre todo el DF
    br_estimator = BayesianRidge()
    imputer = IterativeImputer(estimator=br_estimator, random_state=random_state, max_iter=max_iter, min_value=min_value)
    imputed_array = imputer.fit_transform(df_copy)
    imputed_df = pd.DataFrame(imputed_array, columns=df_copy.columns, index=df_copy.index)

    reporte = evaluate_imputation(df, imputed_df, vars_num)
    return imputed_df, reporte


bridge = impute_bayesridge(df, var_num)


def plot_bayesridge_imputation(df_original, df_imputed, column, bins=30):
    """
    Compara la distribución original vs. imputada para una variable específica
    después de imputación multivariada con BayesianRidge.
    """
    original = df_original[column].dropna()
    imputada = df_imputed[column]

    plt.figure(figsize=(6, 4))
    sns.kdeplot(original, label="Original (sin nulos)", fill=True, color="purple", alpha=0.4)
    sns.kdeplot(imputada, label="Imputada (BayesianRidge)", fill=True, color="orange", alpha=0.6)
    plt.title(f'Distribución de "{column}" antes y después de imputación')
    plt.xlabel(column)
    plt.ylabel("Densidad")
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()


