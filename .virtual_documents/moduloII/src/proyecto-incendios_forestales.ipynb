def evaluate_model(model, X, y, dataset_name="Dataset"):
    # Predicciones
    y_pred = model.predict(X)

    # Métricas
    mse = mean_squared_error(y, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y, y_pred)
    r2 = r2_score(y, y_pred)

    print(f"\n=== Resultados en {dataset_name} ===")
    print(f"MSE:  {mse:.4f}")
    print(f"RMSE: {rmse:.4f}")
    print(f"MAE:  {mae:.4f}")
    print(f"R²:   {r2:.4f}")

    # Gráfico de dispersión: valores reales vs predichos
    plt.figure(figsize=(6,5))
    plt.scatter(y, y_pred, alpha=0.5, color="blue")
    plt.plot([y.min(), y.max()], [y.min(), y.max()], "r--", lw=2, label="Ideal")
    plt.xlabel("Valores reales")
    plt.ylabel("Predicciones")
    plt.title(f"Predicciones vs Reales - {dataset_name}")
    plt.legend()
    plt.show()

    # Gráfico de residuos
    residuals = y - y_pred
    plt.figure(figsize=(6,5))
    plt.scatter(y_pred, residuals, alpha=0.5, color="green")
    plt.axhline(0, color="red", linestyle="--")
    plt.xlabel("Predicciones")
    plt.ylabel("Residuos")
    plt.title(f"Residuos - {dataset_name}")
    plt.show()





