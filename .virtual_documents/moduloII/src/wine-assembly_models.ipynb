    "lgbm__num_leaves": np.arange(20, 150, 20),
    "lgbm__max_depth": [3, 5, 7, 9],
    "lgbm__min_child_samples": np.arange(10, 100, 10),
    "lgbm__bagging_fraction": np.linspace(0.6, 1.0, 5),   # en lugar de subsample
    "lgbm__bagging_freq": [1, 5, 10],                     # en lugar de subsample_freq
    "lgbm__colsample_bytree": np.linspace(0.6, 1.0, 5),
    "lgbm__reg_alpha": np.logspace(-5, 1, 10),
    "lgbm__reg_lambda": np.logspace(-5, 2, 10)
}


random_search_lgbm = RandomizedSearchCV(
    estimator=pipeline,
    param_distributions=param_dist_lgbm,
    n_iter=30,
    cv=5,
    scoring="roc_auc_ovr",
    verbose=1,
    random_state=1998,
    n_jobs=-1
)


random_search_lgbm.fit(X_train, y_train)


best_model_lgbm = random_search_lgbm.best_estimator_
best_params_lgbm = random_search_lgbm.best_params_
best_model_lgbm


cv_scores = cross_val_score(best_model_lgbm, X_train, y_train, cv=5, scoring="accuracy")
print("\n=== Cross Validation ===")
print(f"Media: {cv_scores.mean():.4f}")
print(f"Mediana: {np.median(cv_scores):.4f}")
print(f"Desviación estándar: {cv_scores.std():.4f}")


#Evaluación del rendimiento
evaluate_model(random_search_lgbm, X_train, y_train, "Train")
evaluate_model(random_search_lgbm, X_test, y_test, "Test")





# Importancias de los componentes principales
importances_pcs = best_model_XGB.named_steps["xgb"].feature_importances_

# Loadings del PCA (matriz de componentes)
loadings = best_model_XGB.named_steps["pca"].components_

# Calcular importancia de cada variable original
# Multiplicamos la importancia de cada PC por el cuadrado de sus loadings
importances_original = np.dot(importances_pcs, loadings**2)

# Asociar con nombres de columnas originales
features = X.columns
df_importances = pd.DataFrame({
    "feature": features,
    "importance": importances_original
}).sort_values(by="importance", ascending=False)

# 5. Graficar
plt.figure(figsize=(8,6))
plt.barh(df_importances["feature"], df_importances["importance"], color='#F2F2C9')
plt.xlabel("Importancia aproximada")
plt.title("Importancia de variables originales (proyectadas desde PCA)")
plt.gca().invert_yaxis()
plt.tight_layout()
plt.show()





