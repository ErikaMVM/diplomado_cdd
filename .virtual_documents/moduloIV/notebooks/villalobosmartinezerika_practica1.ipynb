df=pd.read_csv("../data/letters.csv")


df.head()








var_cat = ["letter"]


df["letter"] = df["letter"].astype("category")


var_num = list(set(df.columns) - set(var_cat))


%%time
skim(df)








px_cols = [c for c in df.columns if c not in ['Unnamed: 0','letter']]
len(px_cols)


df[px_cols].describe().T


def show_image(row, px_cols, size=(28,28)):
    arr = row[px_cols].values.astype(float).reshape(size)
    plt.imshow(arr, cmap='gray')
    plt.title(f"letter={row['letter']}")


sample = df.sample(6)
plt.figure(figsize=(8,4))
for i,(idx,row) in enumerate(sample.iterrows()):
    plt.subplot(1,6,i+1)
    show_image(row, px_cols, size=(28,28))
plt.show()








