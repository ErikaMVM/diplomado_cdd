# Region: LabelEncoder
le_region = LabelEncoder()
df["region_encode"] = le_region.fit_transform(df["Region"])

# causa_intencion: LabelEncoder
le_intent = LabelEncoder()
df["causa_encode"] = le_intent.fit_transform(df["causa_intencion"])

# Tipo_de_incendio: LabelEncoder
le_tipoin = LabelEncoder()
df["Tipo_de_incendio_encode"] = le_tipoin.fit_transform(df["Tipo_de_incendio"])

# grupo_vegetacion: LabelEncoder
le_veget = LabelEncoder()
df["vegetacion_encode"] = le_veget.fit_transform(df["grupo_vegetacion"])

# Regimen_de_fuego: LabelEncoder
le_regfueg = LabelEncoder()
df["regimen_fuego_encode"] = le_regfueg.fit_transform(df["Regimen_de_fuego"])


# Duracion_dias: OrdinalEncoder
df["Duracion_dias"] = df["Duracion_dias"].str.lower().str.strip()

orden_duraci = [["1 día", "2 a 3 días", "4 a 7 días", "mayor de 7 días"]]
oe = OrdinalEncoder(categories=orden_duraci)
df["duracion_encode"] = oe.fit_transform(df[["Duracion_dias"]]).astype(int)

# Tipo_impacto: OrdinalEncoder
df["Tipo_impacto"] = df["Tipo_impacto"].str.lower().str.strip()

orden_impacto = [["impacto mínimo", "impacto moderado", "impacto severo"]]
oe = OrdinalEncoder(categories=orden_impacto)
df["impacto_encode"] = oe.fit_transform(df[["Tipo_impacto"]]).astype(int)

# Tamano: OrdinalEncoder
df["Tamano"] = df["Tamano"].str.lower().str.strip()

orden_tamano = [["0 a 5 hectáreas", "6 a 10 hectáreas", "11 a 20 hectáreas", "21 a 50 hectáreas", 
                 "51 a 100 hectáreas", "mayor a 100 hectáreas"]]
oe = OrdinalEncoder(categories=orden_tamano)
df["tamano_encode"] = oe.fit_transform(df[["Tamano"]]).astype(int)


#Eliminamos las variables ya codificadas
df = df.drop(["Region", "causa_intencion", "Tipo_de_incendio", "grupo_vegetacion", "Regimen_de_fuego",
                             "Duracion_dias", "Tipo_impacto", "Tamano"], axis = 1)


df.head()








var_num = ["latitud", "longitud", "Clave_Municipio", "CVE_ENT", "CVEGEO", "Arbolado_Adulto", "Renuevo",
           "Arbustivo", "Herbaceo", "Hojarasca", "Total_hectareas", "Deteccion", "Llegada", "Duracion",
          "duracion_encode", "impacto_encode", "tamano_encode"]


var_date = ["Fecha_Inicio"]


var_id = ["Clave_del_incendio"]


var_cat = ["region_encode", "causa_encode", "Tipo_de_incendio_encode", "vegetacion_encode", 
           "regimen_fuego_encode"]


#Usamos robust-scaling
robustscaler = RobustScaler()
robustscaler.fit(df[var_num])


df_std = pd.DataFrame(robustscaler.transform(df[var_num]), columns = df[var_num].columns, index =  df[var_num].index)


df_std.head()





df = df.sort_values('Fecha_Inicio')
df_std = df_std.loc[df.index]  # asegurar mismo orden


train_size = int(len(df) * 0.8)

X_num_train, X_num_val = df_std.iloc[:train_size], df_std.iloc[train_size:]
X_cat_train, X_cat_val = df[var_cat].iloc[:train_size], df[var_cat].iloc[train_size:]
y_train, y_val = df['Total_hectareas'].iloc[:train_size], df['Total_hectareas'].iloc[train_size:]





# Input numérico (df_std)
input_num = Input(shape=(len(var_num),), name='Numericas_Input')


# Embeddings para cada categórica nominal
embeddings = []
inputs_cat = []


for col in var_cat:
    n_cat = df[col].nunique()  # número de categorías únicas
    emb_dim = int(n_cat**0.5)  # regla práctica: sqrt(n_cat)
    
    inp = Input(shape=(1,), name=f"{col}_Input")
    emb = Embedding(input_dim=n_cat, output_dim=emb_dim, name=f"{col}_Embedding")(inp)
    emb = Flatten()(emb)
    
    inputs_cat.append(inp)
    embeddings.append(emb)








# Concatenar numéricas + embeddings
concat = Concatenate()([input_num] + embeddings)


# Reshape para LSTM (timesteps=1 en este ejemplo)
data = Reshape((1, concat.shape[1]))(concat)








# LSTM + capas densas
x = LSTM(30, activation="tanh")(data)
x = Dropout(0.2)(x)
x = Dense(100, activation="sigmoid")(x)
output = Dense(1)(x)


# Modelo final
model = Model(inputs=[input_num] + inputs_cat, outputs=output)


# Métricas
kmetrics = [
    metrics.RootMeanSquaredError(name='rmse'),
    metrics.MeanAbsoluteError(name='mae'),
    metrics.MeanAbsolutePercentageError(name="mape")
]

early_stopping = EarlyStopping(monitor='val_mae', patience=20)
checkpoint = ModelCheckpoint('models2/model_{val_mae:.3f}.h5',
                             save_best_only=True,
                             save_weights_only=False,
                             monitor='val_mae')


model.compile(loss='mean_squared_error', optimizer='adam', metrics=kmetrics)


model.summary()





%%time
history = model.fit(
    [X_num_train] + [X_cat_train[col].values for col in var_cat],
    y_train,
    epochs=500,
    batch_size=32,
    validation_data=([X_num_val] + [X_cat_val[col].values for col in var_cat], y_val),
    callbacks=[checkpoint, early_stopping]
)


results = pd.DataFrame(history.history)


print(results.tail(1))  # últimas métricas





# Evaluación directa con Keras
val_metrics = model.evaluate(
    [X_num_val] + [X_cat_val[col].values for col in var_cat],
    y_val,
    verbose=1
)


print("\nResultados en validación:")
for name, value in zip(model.metrics_names, val_metrics):
    print(f"{name}: {value:.4f}")


# Predicciones en validación
y_val_pred = model.predict([X_num_val] + [X_cat_val[col].values for col in var_cat])


# Calcular métricas
mae_val = mean_absolute_error(y_val, y_val_pred)
rmse_val = np.sqrt(mean_squared_error(y_val, y_val_pred))
mape_val = mean_absolute_percentage_error(y_val, y_val_pred)


print("\nValidación personalizada:")
print(f"MAE: {mae_val:.4f}")
print(f"RMSE: {rmse_val:.4f}")
print(f"MAPE: {mape_val:.4f}")





# Gráfico comparativo
plt.figure(figsize=(10,6))
plt.plot(y_val.values, label="Valores reales", color="blue")
plt.plot(y_val_pred, label="Predicciones", color="red", linestyle="--")
plt.title("Predicciones vs Valores reales en validación")
plt.xlabel("Índice de muestra (orden temporal)")
plt.ylabel("Total hectáreas")
plt.legend()
plt.show()


plt.figure(figsize=(6,6))
plt.scatter(y_val, y_val_pred, alpha=0.6)
plt.plot([y_val.min(), y_val.max()], [y_val.min(), y_val.max()], 'k--', lw=2)
plt.title("Predicciones vs Reales (Validación)")
plt.xlabel("Valores reales")
plt.ylabel("Predicciones")
plt.show()
