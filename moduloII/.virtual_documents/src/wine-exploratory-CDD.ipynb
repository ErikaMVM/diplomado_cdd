#Remover
def remove_outliers_iforest(df, n_estimators=150, contamination=0.01, random_state=1989):
    model = IForest(n_estimators=n_estimators, contamination=contamination, random_state=random_state)
    model.fit(df)
    preds = model.predict(df)
    return df[preds == 0]


#Detectar
def detect_outliers_iforest(df, n_estimators=150, contamination=0.01, random_state=1989):
    model = IForest(n_estimators=n_estimators, contamination=contamination, random_state=random_state)
    model.fit(df)
    preds = model.predict(df)
    return df[preds == 1]


